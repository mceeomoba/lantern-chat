{
  "expo": {
    "name": "Lantern",
    "slug": "lantern-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#25D366",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.lantern.chat",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@config-plugins/react-native-webrtc",
      [
        "expo-audio",
        {
          "microphonePermission": "Lantern uses the microphone for voice notes and calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lantern lets you pick photos to send.",
          "cameraPermission": "Lantern uses the camera to take photos to send."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lantern shares your location when you choose to send it."
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFB347"
        }
      ]
    ]
  }
}